<div class="pagehead"><div><h1>Leave Records</h1><p>History, status, approvals and CRUD operations.</p></div><a class="btn" href="/Leaves/Create">+ Apply Leave</a></div><div class="panel"><table><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Status</th><th>Actions</th></tr>@foreach(var l in Model){<tr><td>@l.Employee?.Name</td><td>@l.LeaveType</td><td>@l.StartDate.ToString("dd MMM yyyy") – @l.EndDate.ToString("dd MMM yyyy")</td><td>@l.Days</td><td><span class="status @l.Status.ToString().ToLower()">@l.Status</span></td><td>@if(l.Status==LeaveStatus.Pending){<a href="/Leaves/Approve/@l.Id">Approve</a><text> · </text><a href="/Leaves/Reject/@l.Id">Reject</a><text> · </text>}<a href="/Leaves/Edit/@l.Id">Edit</a> · <a href="/Leaves/Delete/@l.Id">Delete</a></td></tr>}</table></div>
