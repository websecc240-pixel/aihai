@model LeaveRequest
<h1>Apply for Leave</h1><div class="panel formbox"><form method="post"><div asp-validation-summary="ModelOnly" class="error"></div><label>Employee</label><select asp-for="EmployeeId" asp-items="@(new SelectList(ViewBag.Employees,"Id","Name"))"><option value="">Select employee</option></select><label>Leave Type</label><select asp-for="LeaveType"><option>Casual</option><option>Sick</option><option>Earned</option><option>Emergency</option><option>Other</option></select><label>Start Date</label><input asp-for="StartDate" type="date"><label>End Date</label><input asp-for="EndDate" type="date"><label>Reason</label><textarea asp-for="Reason"></textarea><button class="btn">Submit Request</button> <a href="/Leaves">Cancel</a></form></div>
