@model LeaveRequest
<h1>Edit Leave Request</h1><div class="panel formbox"><form method="post"><input type="hidden" asp-for="Id"><input type="hidden" asp-for="AppliedOn"><label>Employee</label><select asp-for="EmployeeId" asp-items="@(new SelectList(ViewBag.Employees,"Id","Name"))"></select><label>Leave Type</label><select asp-for="LeaveType"><option>Casual</option><option>Sick</option><option>Earned</option><option>Emergency</option><option>Other</option></select><label>Start Date</label><input asp-for="StartDate" type="date"><label>End Date</label><input asp-for="EndDate" type="date"><label>Reason</label><textarea asp-for="Reason"></textarea><label>Status</label><select asp-for="Status"><option>Pending</option><option>Approved</option><option>Rejected</option></select><button class="btn">Update</button> <a href="/Leaves">Cancel</a></form></div>
